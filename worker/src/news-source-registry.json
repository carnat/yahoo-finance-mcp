    },
    "company_ir": {
      "tier": "official",
      "requiresKey": [],
      "approxSubrequests": 0,
      "description": "Company investor-relations source, served from approved company IR registry entries only."
    },
    "company_ir_page": {
      "tier": "official",
      "requiresKey": [],
      "approxSubrequests": 0,
      "description": "Approved company IR page from the reviewed company IR page registry."
    },
    "newswire": {
      "tier": "official",
      "requiresKey": [],
      "approxSubrequests": 17,
      "description": "GlobeNewswire issuer releases."
    },
    "yahoo_finance": {
      "tier": "aggregator",
      "requiresKey": [],
      "approxSubrequests": 8,
      "description": "Legacy Yahoo Finance source: the news and press releases tabs together."
    },
    "yahoo_finance_news": {
      "tier": "aggregator",
      "requiresKey": [],
      "approxSubrequests": 8,
      "description": "Yahoo Finance news tab."
